#!/bin/sh
# Xsession provides the PAM/elogind session and, normally, its D-Bus bus.
set -u
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    exec dbus-run-session -- "$0" "$@"
fi
export XDG_CURRENT_DESKTOP=dwm XDG_SESSION_DESKTOP=dwm DESKTOP_SESSION=dwm
export XDG_SESSION_TYPE=x11 GTK_USE_PORTAL=0 QT_QPA_PLATFORMTHEME=gtk3
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
unset SESSION_MANAGER
state="${XDG_STATE_HOME:-$HOME/.local/state}/skynet-rice"
mkdir -p "$state"
exec >>"$state/session.log" 2>&1
printf '\nSKYNET session %s\n' "$(date -Is)"
children=
start() {
    if command -v "$1" >/dev/null 2>&1; then
        "$@" &
        children="$children $!"
    fi
}
cleanup() {
    trap - EXIT HUP INT TERM
    for child in $children; do kill "$child" 2>/dev/null || :; done
}
trap cleanup EXIT
trap 'exit 0' HUP INT TERM
# Keep the login screen, desktop and locker on the same physical key map.
if [ -r /etc/default/keyboard ]; then
    . /etc/default/keyboard
    setxkbmap -model "${XKBMODEL:-pc105}" -layout "${XKBLAYOUT:-tr}" \
        -variant "${XKBVARIANT:-}" -option '' -option "${XKBOPTIONS:-}"
fi
# Publish the display to D-Bus activated applications.
dbus-update-activation-environment DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP \
    XDG_SESSION_DESKTOP DESKTOP_SESSION XDG_SESSION_TYPE || :
# Complete the PAM-started keyring before desktop applications request secrets.
# DWM does not run GNOME's autostart entry. This never supplies a password;
# Its encrypted keyring must still be unlocked by PAM or the user.
if [ -x /usr/bin/gnome-keyring-daemon ]; then
    /usr/bin/timeout --kill-after=1s 5s /usr/bin/gnome-keyring-daemon \
        --start --components=secrets >/dev/null || :
fi
# Disable automatic idle locking; explicit and elogind lock requests still work.
xset s 0 0
xset -dpms
# Tested packaged xss-lock manages elogind Lock and the sleep inhibitor.
start xss-lock --transfer-sleep-lock -- /usr/local/libexec/skynet-lock
start xsettingsd
# DWM starts desktop applets through /etc/dwm/autostart.sh.
/usr/local/bin/dwm &
wm=$!
children="$children $wm"
read -r skynet_uptime skynet_idle < /proc/uptime
printf 'SKYNET dwm launched %s uptime=%s pid=%s\n' "$(date -Is)" "$skynet_uptime" "$wm"
# Audio/device initialization must not block the window manager.
start pulseaudio --start
start skynet-usb-sounds --session-pid "$$"
start skynet-audio-leds
start flameshot
start /usr/local/libexec/skynet-session-extras --restore-audio
wait "$wm"
