#!/bin/sh
# PulseAudio and pipewire-pulse use the same pactl interface.
set -eu
export LC_ALL=C
case "${1:-show}" in up|down|mute|mic-mute|show) action=${1:-show};; *) exit 2;; esac
umask 077
exec 9>"${XDG_RUNTIME_DIR:-$HOME/.cache}/dwm-volume.lock"
flock -w 2 9
sink=@DEFAULT_SINK@
case "$action" in
 up) current=$(pactl get-sink-volume "$sink" | awk '/Volume:/ {gsub(/%/, "", $5); print $5; exit}')
     level=$((current + 5)); [ "$level" -le 100 ] || level=100
     pactl set-sink-volume "$sink" "$level%"; pactl set-sink-mute "$sink" 0;;
 down) pactl set-sink-volume "$sink" -5%;;
 mute) pactl set-sink-mute "$sink" toggle;;
 mic-mute)
     pactl set-source-mute @DEFAULT_SOURCE@ toggle
     state=$(pactl get-source-mute @DEFAULT_SOURCE@)
     case "$state" in *yes) label='Microphone muted';; *) label='Microphone unmuted';; esac
     dunstify -a dwm-volume -u low -t 1500 -h string:x-dunst-stack-tag:dwm-microphone "$label"
     exit 0;;
esac
level=$(pactl get-sink-volume "$sink" | awk '/Volume:/ {gsub(/%/, "", $5); print $5; exit}')
state=$(pactl get-sink-mute "$sink")
label="Volume: $level%"; icon=audio-volume-high
case "$state" in *yes) label='Volume muted'; level=0; icon=audio-volume-muted;; esac
dunstify -a dwm-volume -u low -t 1500 -h string:x-dunst-stack-tag:dwm-volume -h "int:value:$level" -i "$icon" "$label"

# Give audible feedback only for speaker level keys, after the level changed.
# A separate nonblocking lock skips overlapping previews during key repeat.
case "$action" in
 up|down)
     feedback_sound="${SKYNET_VOLUME_SOUND:-$HOME/customsounds/Soundleveltest.mp3}"
     if [ "$level" -gt 0 ] && [ -r "$feedback_sound" ] && command -v mpv >/dev/null 2>&1; then
         (
             # Do not let playback hold the volume/notification control lock.
             exec 9>&-
             flock -n 8 || exit 0
             exec mpv --no-config --load-scripts=no --no-video \
                 --audio-display=no --no-terminal --really-quiet \
                 --stop-screensaver=no --ao=pulse \
                 --audio-client-name='SKYNET Volume' --volume=100 \
                 --audio-buffer=0.05 --pulse-buffer=50 \
                 --af='lavfi=[silenceremove=start_periods=1:start_duration=0.002:start_threshold=-60dB:start_silence=0.01:detection=peak:window=0.005]' \
                 -- "$feedback_sound"
         ) 8>"${XDG_RUNTIME_DIR:-$HOME/.cache}/dwm-volume-feedback.lock" \
             </dev/null >/dev/null 2>&1 &
     fi
     ;;
esac
