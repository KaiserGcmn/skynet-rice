--- a/etc/init.d/saned
+++ b/etc/init.d/saned
@@ -34,6 +34,13 @@
 fi
 
 DAEMON_OPTS="-a $RUN_AS_USER"
+# One IPv6 dual-stack listener already accepts IPv4-mapped clients.
+# Avoid attempting a second overlapping IPv4 bind on dual-stack hosts.
+if [ -r /proc/sys/net/ipv6/bindv6only ] &&
+   [ "$(cat /proc/sys/net/ipv6/bindv6only)" = 0 ] &&
+   [ "$(cat /proc/sys/net/ipv6/conf/all/disable_ipv6 2>/dev/null)" = 0 ]; then
+    DAEMON_OPTS="$DAEMON_OPTS -b ::"
+fi
 
 set -e
 
