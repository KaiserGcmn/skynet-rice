{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/skynet-globe.txt",
    "color": {
      "1": "38;2;164;40;57",
      "2": "38;2;255;64;80",
      "3": "38;2;221;227;234",
      "4": "38;2;62;51;63",
      "5": "38;2;169;187;197",
      "6": "38;2;118;28;40"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;169;187;197",
      "title": "38;2;255;64;80",
      "output": "38;2;221;227;234",
      "separator": "38;2;164;40;57"
    },
    "brightColor": false,
    "percent": {
      "type": 3,
      "color": {
        "green": "38;2;194;45;61",
        "yellow": "38;2;255;64;80",
        "red": "38;2;255;106;118"
      }
    },
    "bar": {
      "width": 18,
      "charElapsed": "━",
      "charTotal": "\u001b[38;2;62;51;63m━",
      "borderLeft": "",
      "borderRight": ""
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "{#1;38;2;236;238;241;48;2;114;18;30} SKYNET {#0}{#38;2;255;64;80}▌{#38;2;169;187;197} NEURAL NET CONTROL {#38;2;62;51;63}────────────────────────── {#38;2;255;64;80}● {#38;2;221;227;234}ONLINE"
    },
    {
      "type": "custom",
      "format": "{#38;2;164;40;57}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    },
    {
      "type": "title",
      "key": "{#38;2;169;187;197}  OPERATOR  ",
      "format": "{#38;2;221;227;234}{user-name}{#38;2;255;64;80}@{#38;2;221;227;234}{host-name}"
    },
    "break",
    {
      "type": "custom",
      "format": "{#38;2;255;64;80}▌{#48;2;27;13;19;38;2;255;64;80} 01 {#48;2;27;13;19;38;2;221;227;234}CHASSIS {#0}{#38;2;164;40;57} ──────────────────────────────────────────{#38;2;62;51;63} HW.CORE"
    },
    {
      "type": "host",
      "key": "{#38;2;164;40;57}│ {#38;2;169;187;197}HOST      ",
      "format": "{#38;2;221;227;234}{name}"
    },
    {
      "type": "cpu",
      "key": "{#38;2;164;40;57}│ {#38;2;169;187;197}CPU       ",
      "format": "{#38;2;221;227;234}{name} {#38;2;62;51;63}· {#38;2;221;227;234}{cores-logical}T {#38;2;62;51;63}· {#38;2;221;227;234}{freq-max}"
    },
    {
      "type": "gpu",
      "key": "{#38;2;164;40;57}│ {#38;2;169;187;197}GPU       ",
      "format": "{#38;2;221;227;234}{name} {#38;2;62;51;63}· {#38;2;169;187;197}{type}"
    },
    {
      "type": "display",
      "key": "{#38;2;164;40;57}│ {#38;2;169;187;197}DISPLAY   ",
      "format": "{#38;2;221;227;234}{width}×{height}{?refresh-rate} {#38;2;62;51;63}· {#38;2;221;227;234}{refresh-rate} Hz{?}{?inch} {#38;2;62;51;63}· {#38;2;221;227;234}{inch}\"{?}"
    },
    {
      "type": "custom",
      "format": "{#38;2;255;64;80}▌{#48;2;27;13;19;38;2;255;64;80} 02 {#48;2;27;13;19;38;2;221;227;234}NEURAL LOAD {#0}{#38;2;164;40;57} ─────────────────────────────────────{#38;2;62;51;63} RES.BANK"
    },
    {
      "type": "memory",
      "key": "{#38;2;164;40;57}│ {#38;2;169;187;197}MEMORY    ",
      "format": "{percentage-bar} {#38;2;221;227;234}{percentage>4}  {used>10} {#38;2;164;40;57}/ {#38;2;169;187;197}{total}"
    },
    {
      "type": "swap",
      "key": "{#38;2;164;40;57}│ {#38;2;169;187;197}SWAP      ",
      "format": "{percentage-bar} {#38;2;221;227;234}{percentage>4}  {used>10} {#38;2;164;40;57}/ {#38;2;169;187;197}{total}"
    },
    {
      "type": "disk",
      "key": "{#38;2;164;40;57}│ {#38;2;169;187;197}DISK      ",
      "folders": "/",
      "format": "{size-percentage-bar} {#38;2;221;227;234}{size-percentage>4}  {size-used>10} {#38;2;164;40;57}/ {#38;2;169;187;197}{size-total}"
    },
    {
      "type": "battery",
      "key": "{#38;2;164;40;57}│ {#38;2;169;187;197}POWER CELL",
      "format": "{capacity-bar} {#38;2;221;227;234}{capacity>4}  {#38;2;169;187;197}{status}"
    },
    {
      "type": "loadavg",
      "key": "{#38;2;164;40;57}│ {#38;2;169;187;197}LOAD AVG  ",
      "format": "{#38;2;221;227;234}{1} {#38;2;62;51;63}· {#38;2;221;227;234}{2} {#38;2;62;51;63}· {#38;2;221;227;234}{3}"
    },
    {
      "type": "custom",
      "format": "{#38;2;255;64;80}▌{#48;2;27;13;19;38;2;255;64;80} 03 {#48;2;27;13;19;38;2;221;227;234}KERNEL {#0}{#38;2;164;40;57} ──────────────────────────────────────────{#38;2;62;51;63} SYS.BOOT"
    },
    {
      "type": "os",
      "key": "{#38;2;164;40;57}│ {#38;2;169;187;197}OS        ",
      "format": "{#38;2;221;227;234}{pretty-name} {#38;2;62;51;63}· {#38;2;169;187;197}{arch}"
    },
    {
      "type": "kernel",
      "key": "{#38;2;164;40;57}│ {#38;2;169;187;197}KERNEL    ",
      "format": "{#38;2;221;227;234}{release}"
    },
    {
      "type": "bios",
      "key": "{#38;2;164;40;57}│ {#38;2;169;187;197}BIOS      ",
      "format": "{#38;2;221;227;234}{version} {#38;2;62;51;63}· {#38;2;169;187;197}{release}"
    },
    {
      "type": "packages",
      "key": "{#38;2;164;40;57}│ {#38;2;169;187;197}PACKAGES  ",
      "format": "{#38;2;221;227;234}{all}{#38;2;169;187;197} INSTALLED"
    },
    {
      "type": "custom",
      "format": "{#38;2;255;64;80}▌{#48;2;27;13;19;38;2;255;64;80} 04 {#48;2;27;13;19;38;2;221;227;234}INTERFACE {#0}{#38;2;164;40;57} ───────────────────────────────────────{#38;2;62;51;63} HMI.LINK"
    },
    {
      "type": "shell",
      "key": "{#38;2;164;40;57}│ {#38;2;169;187;197}SHELL     ",
      "format": "{#38;2;221;227;234}{pretty-name} {#38;2;62;51;63}· {#38;2;169;187;197}{version}"
    },
    {
      "type": "wm",
      "key": "{#38;2;164;40;57}│ {#38;2;169;187;197}WM        ",
      "format": "{#38;2;221;227;234}{pretty-name} {#38;2;62;51;63}· {#38;2;169;187;197}{protocol-name}"
    },
    {
      "type": "terminal",
      "key": "{#38;2;164;40;57}│ {#38;2;169;187;197}TERMINAL  ",
      "format": "{#38;2;221;227;234}{pretty-name} {#38;2;62;51;63}· {#38;2;169;187;197}{version}"
    },
    {
      "type": "terminalfont",
      "key": "{#38;2;164;40;57}│ {#38;2;169;187;197}FONT      ",
      "format": "{#38;2;221;227;234}{name} {#38;2;62;51;63}· {#38;2;169;187;197}{size}pt"
    },
    {
      "type": "uptime",
      "key": "{#38;2;164;40;57}│ {#38;2;169;187;197}UPTIME    ",
      "format": "{#38;2;221;227;234}{days}d {hours}h {minutes}m"
    },
    {
      "type": "command",
      "key": "{#38;2;164;40;57}│ {#38;2;169;187;197}AGE       ",
      "text": "\"$HOME/.local/bin/os-age\"",
      "format": "{#38;2;221;227;234}{result}"
    },
    "break",
    {
      "type": "custom",
      "format": "{#38;2;164;40;57}└──{#38;2;255;64;80}◆ {#38;2;169;187;197}WE SOLVE HUMAN PROBLEMS{#38;2;62;51;63}. {#38;2;255;64;80}PERMANENTLY{#38;2;62;51;63}. {#38;2;164;40;57}─────────────────────"
    },
    {
      "type": "custom",
      "format": "   {#38;2;27;13;19}▀▀▀▀▀▀▀{#38;2;72;23;34}▀▀▀▀▀▀▀{#38;2;164;40;57}▀▀▀▀▀▀▀{#38;2;194;45;61}▀▀▀▀▀▀▀{#38;2;255;64;80}▀▀▀▀▀▀▀{#38;2;255;106;118}▀▀▀▀▀▀▀{#38;2;169;187;197}▀▀▀▀▀▀▀{#38;2;221;227;234}▀▀▀▀▀▀▀ {#38;2;62;51;63}SYS.1"
    },
    "break"
  ]
}
