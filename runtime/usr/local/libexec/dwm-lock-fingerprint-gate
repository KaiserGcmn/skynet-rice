#!/usr/bin/python3
"""Remember that the lock screen's fingerprint stage already failed.

Used by the `dwm-fingerprint` PAM service through pam_exec. Every failed
password makes XSecureLock start a new PAM transaction, which would run the
fingerprint scan again. After a failed scan only the password is wanted, so:

  check  exit 0 if the fingerprint stage failed less than --ttl seconds ago
  mark   record a failed fingerprint stage (refreshes the time)
  clear  forget it after a successful unlock

The helper never authenticates anyone. `check` only lets PAM skip the
fingerprint module; any error or doubt leaves the normal order unchanged
(fingerprint first, then password).
"""
import argparse
import os
import stat
import sys
import time

MARKER = 'dwm-lock-password-only'
DEFAULT_TTL = 120


def state_dir(override=None):
    return override or f'/run/user/{os.getuid()}'


def private_dir(path):
    """True if path is a real directory only this user can modify."""
    try:
        info = os.lstat(path)
    except OSError:
        return False
    return (stat.S_ISDIR(info.st_mode) and info.st_uid == os.getuid()
            and not info.st_mode & 0o022)


def fresh(path, ttl, now=None):
    try:
        info = os.lstat(path)
    except OSError:
        return False
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid():
        return False
    age = (time.time() if now is None else now) - info.st_mtime
    # A timestamp in the future (clock change) is never trusted.
    return 0 <= age < ttl


def check(directory, ttl):
    return private_dir(directory) and fresh(os.path.join(directory, MARKER), ttl)


def mark(directory):
    if not private_dir(directory):
        return False
    flags = os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC
    try:
        fd = os.open(os.path.join(directory, MARKER), flags, 0o600)
    except OSError:
        return False
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid():
            return False
        os.utime(fd)
        return True
    except OSError:
        return False
    finally:
        os.close(fd)


def clear(directory):
    if not private_dir(directory):
        return True
    try:
        os.unlink(os.path.join(directory, MARKER))
    except FileNotFoundError:
        pass
    except OSError:
        return False
    return True


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument('action', choices=('check', 'mark', 'clear'))
    parser.add_argument('--ttl', type=int, default=DEFAULT_TTL,
                        help='seconds a failed fingerprint stage is remembered')
    parser.add_argument('--state-dir', help='directory for the marker (tests)')
    try:
        args = parser.parse_args(argv)
    except SystemExit:
        return 2
    directory = state_dir(args.state_dir)
    if args.action == 'check':
        ok = check(directory, max(args.ttl, 0))
    elif args.action == 'mark':
        ok = mark(directory)
    else:
        ok = clear(directory)
    return 0 if ok else 1


if __name__ == '__main__':
    sys.exit(main())
