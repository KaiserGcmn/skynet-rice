#!/bin/sh
# Exact-ABI reviewed VMD backports; future kernels keep their packaged driver.
set -eu
case "${1:-}" in prereqs) exit 0 ;; esac
case "$version" in
6.12.111+deb13-amd64)
. /usr/share/initramfs-tools/hook-functions
manual_add_modules vmd
apply_add_modules
printf '%s\n' '6edec8c09f3b2d3e7284cf9981cdf20a6741041215af3762a7cd2180c43b6c42  /usr/local/lib/expertbook-boot/6.12.111+deb13-amd64/vmd.ko.xz' | sha256sum --check --status
target="$DESTDIR/usr/lib/modules/$version/kernel/drivers/pci/controller/vmd.ko.xz"
test -f "$target"
install -m 0644 /usr/local/lib/expertbook-boot/6.12.111+deb13-amd64/vmd.ko.xz "$target"
    ;;
6.12.113+deb13-amd64)
    . /usr/share/initramfs-tools/hook-functions
    manual_add_modules vmd
    apply_add_modules
    printf '%s\n' '1f2cc52fa3b488c05d1682f38fe31bd6cfbb1ecaf612803430aefbca5a19a38f  /usr/local/lib/expertbook-boot/6.12.113+deb13-amd64/vmd.ko.xz' | sha256sum --check --status
    target="$DESTDIR/usr/lib/modules/$version/kernel/drivers/pci/controller/vmd.ko.xz"
    test -f "$target"
    install -m 0644 /usr/local/lib/expertbook-boot/6.12.113+deb13-amd64/vmd.ko.xz "$target"
    ;;
esac
