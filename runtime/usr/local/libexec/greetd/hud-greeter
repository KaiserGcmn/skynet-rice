#!/bin/sh
# Graphic SKYNET greeter, with the existing TTY interface on failure.
set -u
umask 077
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 LANGUAGE=en_US:en
# Use the same keyboard map as the console (Turkish on this machine).
if [ -r /etc/default/keyboard ]; then
    . /etc/default/keyboard
    export XKB_DEFAULT_LAYOUT="${XKBLAYOUT:-tr}"
    export XKB_DEFAULT_MODEL="${XKBMODEL:-pc105}"
    export XKB_DEFAULT_VARIANT="${XKBVARIANT:-}"
    export XKB_DEFAULT_OPTIONS="${XKBOPTIONS:-}"
fi
skynet_runtime=
skynet_cleanup() {
    if [ -n "$skynet_runtime" ]; then
        rm -rf -- "$skynet_runtime"
        skynet_runtime=
    fi
}
trap skynet_cleanup EXIT
trap 'exit 1' HUP INT TERM
skynet_notice() {
    printf '%s\n' "hud-greeter: $*" >&2
    logger -t hud-greeter -p daemon.warning -- "$*" || :
}
skynet_version=$(dpkg-query -W -f='${Version}' gtkgreet 2>/dev/null || :)
# Do not keep using this locally built UI after an upstream security update.
if [ "$skynet_version" = '0.8-1+b1' ] && [ -x /usr/bin/cage ] &&
   [ -x /usr/local/libexec/greetd/gtkgreet-hud ]; then
    skynet_attempt=1
    while [ "$skynet_attempt" -le 3 ]; do
        skynet_runtime=$(mktemp -d /tmp/hud-greeter.XXXXXXXX) || skynet_runtime=
        if [ -z "$skynet_runtime" ]; then
            skynet_notice "Cannot create private graphical runtime; using TTY fallback."
            break
        fi
        export XDG_RUNTIME_DIR="$skynet_runtime"
        export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=Cage
        export GDK_BACKEND=wayland GTK_THEME=Adwaita:dark GTK_USE_PORTAL=0
        # The greeter needs no session bus, accessibility bus or portals.
        # Without an address GLib autolaunched a session bus through X11,
        # which started Xwayland, an accessibility bus and desktop portals.
        export DBUS_SESSION_BUS_ADDRESS=disabled: NO_AT_BRIDGE=1
        unset GTK_MODULES GTK_PATH LD_PRELOAD LD_LIBRARY_PATH DISPLAY WAYLAND_DISPLAY
        # Keep GTK/authentication diagnostics on the original stderr (fd 3).
        # Only Cage's compositor diagnostics go to the private temporary file.
        if /usr/bin/cage -s -- /bin/sh -c 'exec "$@" 2>&3 3>&-' skynet-gtk \
            /usr/local/libexec/greetd/gtkgreet-hud \
            --style /etc/greetd/gtkgreet-hud.css \
            --command '/usr/local/libexec/greetd/start-x /usr/local/bin/dwm-session' \
            3>&2 2>"$skynet_runtime/cage.log"; then
            skynet_status=0
        else
            skynet_status=$?
        fi
        # Preserve diagnostics even when an early boot failure is recovered.
        if [ -s "$skynet_runtime/cage.log" ]; then
            cat -- "$skynet_runtime/cage.log" >&2
            logger -t hud-greeter -p daemon.warning --file "$skynet_runtime/cage.log" || :
        fi
        skynet_cleanup
        if [ "$skynet_status" -eq 0 ]; then
            exit 0
        fi
        skynet_notice "Graphical attempt $skynet_attempt/3 exited with status $skynet_status."
        if [ "$skynet_attempt" -lt 3 ]; then
            # Only failures wait. Never delay or time out a working login UI.
            sleep 1
        fi
        skynet_attempt=$((skynet_attempt + 1))
    done
    unset XDG_RUNTIME_DIR XDG_SESSION_TYPE XDG_CURRENT_DESKTOP GDK_BACKEND GTK_THEME GTK_USE_PORTAL \
        DBUS_SESSION_BUS_ADDRESS NO_AT_BRIDGE
    skynet_notice "Graphical startup retries exhausted; using TTY fallback."
else
    skynet_notice "Graphical UI unavailable or gtkgreet version changed ($skynet_version); using TTY fallback."
fi
# Functional fallback: keep the already installed login flow available.
exec /usr/local/libexec/greetd/tuigreet-capslock --time --remember --remember-user-session --user-menu --asterisks --greeting '                       /\                       
                     /----\                     
                   /--------\                   
             /\    \--------/    /\             
           /----\    \----/    /----\           
         /--------\    \/    /--------\         
       /------------\      /------------\       
     /----------------\  /----------------\     
   /------------------|  |------------------\   
 /--------------------|  |--------------------\ 
_______________________  _______________________

                  S K Y N E T                   
         CYBERDYNE SYSTEMS CORPORATION          ' --xsessions /usr/share/xsessions --xsession-wrapper /usr/local/libexec/greetd/start-x --cmd '/usr/local/libexec/greetd/start-x /usr/local/bin/dwm-session' --theme 'border=red;title=lightred;text=white;greet=lightred;prompt=lightred;input=white;time=white;action=white;button=white;container=black' --width 70 --container-padding 1 --prompt-padding 1 --greet-align center --time-format '%d.%m.%Y / %H:%M'
