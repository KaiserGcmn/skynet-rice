[global]
    follow = keyboard
    origin = top-right
    offset = (16, 42)
    width = 280
    height = (0, 180)
    notification_limit = 4

    font = JetBrains Mono 10
    format = "<b>%s</b>\n%b"
    padding = 12
    horizontal_padding = 14
    frame_width = 2
    frame_color = "#005577"
    corner_radius = 8

    enable_recursive_icon_lookup = true
    icon_theme = breeze-dark, Adwaita
    icon_position = left
    max_icon_size = 32

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_min_width = 220
    progress_bar_max_width = 250
    progress_bar_corner_radius = 4

    mouse_left_click = close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#222222"
    foreground = "#eeeeee"
    highlight = "#55b8d0"
    timeout = 3s

[urgency_normal]
    background = "#222222"
    foreground = "#eeeeee"
    highlight = "#55b8d0"
    timeout = 5s

[urgency_critical]
    background = "#222222"
    foreground = "#eeeeee"
    frame_color = "#e06c75"
    timeout = 0

[volume]
    appname = dwm-volume
    format = "<b>%s</b>"
    history_ignore = yes
    set_transient = yes
    timeout = 1500ms

[brightness]
    appname = dwm-brightness
    format = "<b>%s</b>"
    history_ignore = yes
    set_transient = yes
    timeout = 1500ms
