+static void request_worker(GTask *task, gpointer object, gpointer data, GCancellable *cancel) {
+    struct pending_request *pending = data;
+    struct response *response = g_new(struct response, 1);
+    *response = roundtrip(&pending->request);
+    g_task_return_pointer(task, response, g_free);
+}
+
+static void request_done(GObject *object, GAsyncResult *result, gpointer unused) {
+    GTask *task = G_TASK(result);
+    struct pending_request *pending = g_task_get_task_data(task);
+    struct response *response = g_task_propagate_pointer(task, NULL);
+    gtkgreet->auth_pending = FALSE;
+    handle_response(*response, pending->next, pending->reset_message);
+    g_free(response);
+}
+
+static void send_request(struct request request, enum next_action next, const char *message) {
+    if (gtkgreet->auth_pending) {
+        clear_request(&request);
+        return;
+    }
+    struct pending_request *pending = g_new0(struct pending_request, 1);
+    pending->request = request;
+    clear_request(&request);
+    pending->next = next;
+    pending->reset_message = g_strdup(message);
+    gtkgreet->auth_pending = TRUE;
+    GTask *task = g_task_new(NULL, NULL, request_done, NULL);
+    g_task_set_task_data(task, pending, free_pending);
+    g_task_run_in_thread(task, request_worker);
+    g_object_unref(task);
+}
