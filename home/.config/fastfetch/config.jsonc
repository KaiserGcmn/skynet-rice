{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "@@HOME@@/.config/fastfetch/skynet-logo.txt",
    "color": {
      "1": "38;2;133;17;29",
      "2": "38;2;211;24;34",
      "3": "38;2;247;31;40",
      "4": "38;2;255;64;54",
      "5": "38;2;106;32;38",
      "6": "38;2;151;128;130",
      "7": "38;2;232;232;228"
    },
    "padding": {
      "top": 4,
      "left": 1,
      "right": 3
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;255;43;46m┏\u001b[1;38;2;245;232;224;48;2;169;16;26m SKYNET \u001b[0m\u001b[38;2;151;128;130m / SYSTEM DIAGNOSTICS \u001b[38;2;106;32;38m━━━━━━━━━━━━━━━━━╸ ━━━╸\u001b[0m"
    },
    {
      "type": "title",
      "format": "\u001b[38;2;106;32;38m┃  \u001b[38;2;219;218;215m{user-name}\u001b[38;2;211;26;34m@\u001b[38;2;151;128;130m{host-name}\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;106;32;38m┃\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;106;32;38m┣\u001b[1;38;2;245;232;224;48;2;169;16;26m 0x01 \u001b[0m\u001b[38;2;255;43;46m 𝙃𝘼𝙍𝘿𝙒𝘼𝙍𝙀 \u001b[38;2;106;32;38m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╸ ━━━╸\u001b[0m"
    },
    {
      "type": "host",
      "key": "\u001b[38;2;106;32;38m┃\u001b[38;2;183;102;105m  HOST   ",
      "keyColor": "38;2;183;102;105",
      "format": "{name}"
    },
    {
      "type": "cpu",
      "key": "\u001b[38;2;106;32;38m┃\u001b[38;2;183;102;105m  CPU    ",
      "keyColor": "38;2;183;102;105",
      "format": "{name}  /  {cores-logical}T"
    },
    {
      "type": "cpu",
      "key": "\u001b[38;2;106;32;38m┃\u001b[38;2;183;102;105m  CLOCK  ",
      "keyColor": "38;2;183;102;105",
      "format": "{freq-max}  /  MAX"
    },
    {
      "type": "gpu",
      "key": "\u001b[38;2;106;32;38m┃\u001b[38;2;183;102;105m  GPU    ",
      "keyColor": "38;2;183;102;105",
      "format": "{name}  /  {type}"
    },
    {
      "type": "display",
      "key": "\u001b[38;2;106;32;38m┃\u001b[38;2;183;102;105m  DISPLAY",
      "keyColor": "38;2;183;102;105",
      "format": "{width}×{height}  /  {refresh-rate} Hz"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;106;32;38m┃\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;106;32;38m┣\u001b[1;38;2;245;232;224;48;2;169;16;26m 0x02 \u001b[0m\u001b[38;2;255;43;46m 𝙍𝙀𝙎𝙊𝙐𝙍𝘾𝙀𝙎 \u001b[38;2;106;32;38m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╸ ━━━╸\u001b[0m"
    },
    {
      "type": "memory",
      "key": "\u001b[38;2;106;32;38m┃\u001b[38;2;183;102;105m  MEMORY ",
      "keyColor": "38;2;183;102;105",
      "format": "{percentage-bar} \u001b[38;2;211;26;34m{percentage>4}\u001b[38;2;219;218;215m  {used} / {total}"
    },
    {
      "type": "swap",
      "key": "\u001b[38;2;106;32;38m┃\u001b[38;2;183;102;105m  SWAP   ",
      "keyColor": "38;2;183;102;105",
      "format": "{percentage-bar} \u001b[38;2;211;26;34m{percentage>4}\u001b[38;2;219;218;215m  {used} / {total}"
    },
    {
      "type": "disk",
      "key": "\u001b[38;2;106;32;38m┃\u001b[38;2;183;102;105m  DISK   ",
      "keyColor": "38;2;183;102;105",
      "format": "{size-percentage-bar} \u001b[38;2;211;26;34m{size-percentage>4}\u001b[38;2;219;218;215m  {size-used} / {size-total}"
    },
    {
      "type": "battery",
      "key": "\u001b[38;2;106;32;38m┃\u001b[38;2;183;102;105m  POWER  ",
      "keyColor": "38;2;183;102;105",
      "format": "{capacity-bar} \u001b[38;2;211;26;34m{capacity>4}\u001b[38;2;219;218;215m  {status}"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;106;32;38m┃\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;106;32;38m┣\u001b[1;38;2;245;232;224;48;2;169;16;26m 0x03 \u001b[0m\u001b[38;2;255;43;46m 𝙎𝙊𝙁𝙏𝙒𝘼𝙍𝙀 \u001b[38;2;106;32;38m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╸ ━━━╸\u001b[0m"
    },
    {
      "type": "os",
      "key": "\u001b[38;2;106;32;38m┃\u001b[38;2;183;102;105m  OS     ",
      "keyColor": "38;2;183;102;105",
      "format": "{pretty-name}  /  {arch}"
    },
    {
      "type": "kernel",
      "key": "\u001b[38;2;106;32;38m┃\u001b[38;2;183;102;105m  KERNEL ",
      "keyColor": "38;2;183;102;105",
      "format": "{release}"
    },
    {
      "type": "bios",
      "key": "\u001b[38;2;106;32;38m┃\u001b[38;2;183;102;105m  BIOS   ",
      "keyColor": "38;2;183;102;105"
    },
    {
      "type": "packages",
      "key": "\u001b[38;2;106;32;38m┃\u001b[38;2;183;102;105m  PKGS   ",
      "keyColor": "38;2;183;102;105"
    },
    {
      "type": "shell",
      "key": "\u001b[38;2;106;32;38m┃\u001b[38;2;183;102;105m  SHELL  ",
      "keyColor": "38;2;183;102;105"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;106;32;38m┃\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;106;32;38m┣\u001b[1;38;2;245;232;224;48;2;169;16;26m 0x04 \u001b[0m\u001b[38;2;255;43;46m 𝙎𝙀𝙎𝙎𝙄𝙊𝙉 \u001b[38;2;106;32;38m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╸ ━━━╸\u001b[0m"
    },
    {
      "type": "de",
      "key": "\u001b[38;2;106;32;38m┃\u001b[38;2;183;102;105m  DESKTOP",
      "keyColor": "38;2;183;102;105"
    },
    {
      "type": "lm",
      "key": "\u001b[38;2;106;32;38m┃\u001b[38;2;183;102;105m  LOGIN  ",
      "keyColor": "38;2;183;102;105"
    },
    {
      "type": "wm",
      "key": "\u001b[38;2;106;32;38m┃\u001b[38;2;183;102;105m  WM     ",
      "keyColor": "38;2;183;102;105"
    },
    {
      "type": "wmtheme",
      "key": "\u001b[38;2;106;32;38m┃\u001b[38;2;183;102;105m  THEME  ",
      "keyColor": "38;2;183;102;105"
    },
    {
      "type": "terminal",
      "key": "\u001b[38;2;106;32;38m┃\u001b[38;2;183;102;105m  TERM   ",
      "keyColor": "38;2;183;102;105"
    },
    {
      "type": "terminalfont",
      "key": "\u001b[38;2;106;32;38m┃\u001b[38;2;183;102;105m  FONT   ",
      "keyColor": "38;2;183;102;105"
    },
    {
      "type": "command",
      "key": "\u001b[38;2;106;32;38m┃\u001b[38;2;183;102;105m  AGE    ",
      "keyColor": "38;2;183;102;105",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "uptime",
      "key": "\u001b[38;2;106;32;38m┃\u001b[38;2;183;102;105m  UPTIME ",
      "keyColor": "38;2;183;102;105"
    },
    {
      "type": "datetime",
      "key": "\u001b[38;2;106;32;38m┃\u001b[38;2;183;102;105m  DATE   ",
      "keyColor": "38;2;183;102;105",
      "format": "{year}-{month-pretty}-{day-pretty}  /  {hour-pretty}:{minute-pretty}"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;106;32;38m┗━━━━━━━━━━━━━━━━━━━━━━━━━━━╸ \u001b[38;2;70;28;33m━━━ \u001b[38;2;106;32;38m━━━ \u001b[38;2;211;26;34m━━━ \u001b[38;2;255;43;46m━━━━━╸\u001b[0m"
    }
  ],
  "display": {
    "color": {
      "keys": "38;2;183;102;105",
      "title": "38;2;255;43;46",
      "output": "38;2;219;218;215",
      "separator": "38;2;106;32;38"
    },
    "percent": {
      "type": 3,
      "color": {
        "green": "38;2;211;26;34",
        "yellow": "38;2;255;43;46",
        "red": "38;2;255;119;109"
      }
    },
    "separator": "  ",
    "brightColor": false,
    "bar": {
      "width": 8,
      "charElapsed": "▰",
      "charTotal": "\u001b[38;2;70;28;33m▱",
      "borderLeft": "",
      "borderRight": ""
    }
  }
}
