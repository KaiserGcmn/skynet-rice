+++ b/power_button.h
@@ -0,0 +1,189 @@
+/* Local power controls. The existing keyboard/pointer grabs and PAM helpers
+ * remain responsible for locking and authentication. No input is forwarded
+ * to desktop windows and these controls never unlock the session. */
+#include <errno.h>
+#include <sys/wait.h>
+#ifdef HAVE_XRANDR_EXT
+#include <X11/extensions/Xrandr.h>
+#endif
+
+enum { POWER_REBOOT, POWER_SHUTDOWN, POWER_ACTION_COUNT };
+static Window power_button_window;
+static GC power_button_gc;
+static XFontStruct *power_button_font;
+static int power_button_x, power_button_y;
+static int power_local_x[POWER_ACTION_COUNT], power_local_y[POWER_ACTION_COUNT];
+static const unsigned int power_button_width = 240, power_button_height = 54;
+static int power_button_pressed = -1, power_pending_action = -1;
+static int power_button_status[POWER_ACTION_COUNT];
+static pid_t power_button_pid;
+static unsigned long power_button_foreground, power_button_border;
+static unsigned long power_button_background;
+
+static unsigned long PowerButtonColor(Display *dpy, const char *name) {
+  XColor color, exact;
+  if (XAllocNamedColor(dpy, DefaultColormap(dpy, DefaultScreen(dpy)), name,
+                      &color, &exact)) return color.pixel;
+  return WhitePixel(dpy, DefaultScreen(dpy));
+}
+
+static void PowerButtonPlace(Display *dpy, int width, int height) {
+  int left = 0, top = 0;
+#ifdef HAVE_XRANDR_EXT
+  int count = 0;
+  XRRMonitorInfo *monitors = XRRGetMonitors(dpy, DefaultRootWindow(dpy), True,
+                                          &count);
+  if (monitors && count > 0) {
+    int chosen = 0;
+    for (int i = 0; i < count; ++i)
+      if (monitors[i].primary) { chosen = i; break; }
+    left = monitors[chosen].x;
+    top = monitors[chosen].y;
+    width = monitors[chosen].width;
+    height = monitors[chosen].height;
+  }
+  if (monitors) XRRFreeMonitors(monitors);
+#endif
+  const int horizontal = width >= (int)(2 * power_button_width + 12 + 56);
+  const unsigned int panel_width = horizontal ? 2 * power_button_width + 12 :
+                                                power_button_width;
+  const unsigned int panel_height = horizontal ? power_button_height :
+                                                2 * power_button_height + 12;
+  power_local_x[POWER_SHUTDOWN] = horizontal ? power_button_width + 12 : 0;
+  power_local_y[POWER_SHUTDOWN] = horizontal ? 0 : power_button_height + 12;
+  power_button_x = left + width - (int)panel_width - 28;
+  power_button_y = top + height - (int)panel_height - 28;
+  if (power_button_x < left) power_button_x = left;
+  if (power_button_y < top) power_button_y = top;
+  power_button_pressed = -1;
+  XMoveResizeWindow(dpy, power_button_window, power_button_x, power_button_y,
+                    panel_width, panel_height);
+}
+
+static void PowerButtonDraw(Display *dpy) {
+  static const char *labels[POWER_ACTION_COUNT][3] = {
+    {"Reboot [F11]", "Rebooting...", "Reboot blocked"},
+    {"Shut down [F12]", "Shutting down...", "Shutdown blocked"}
+  };
+  XClearWindow(dpy, power_button_window);
+  for (int action = 0; action < POWER_ACTION_COUNT; ++action) {
+    const int x = power_local_x[action], y = power_local_y[action];
+    const char *label = labels[action][power_button_status[action]];
+    XSetForeground(dpy, power_button_gc, power_button_background);
+    XFillRectangle(dpy, power_button_window, power_button_gc, x, y,
+                    power_button_width, power_button_height);
+    XSetForeground(dpy, power_button_gc, power_button_border);
+    XSetLineAttributes(dpy, power_button_gc, 1, LineSolid, CapRound, JoinRound);
+    XDrawRectangle(dpy, power_button_window, power_button_gc, x, y,
+                   power_button_width - 1, power_button_height - 1);
+    XSetForeground(dpy, power_button_gc, power_button_foreground);
+    XSetLineAttributes(dpy, power_button_gc, 2, LineSolid, CapRound, JoinRound);
+    if (action == POWER_REBOOT) {
+      XDrawArc(dpy, power_button_window, power_button_gc, x + 19, y + 18,
+               18, 18, 45 * 64, 300 * 64);
+      XDrawLine(dpy, power_button_window, power_button_gc,
+                x + 35, y + 18, x + 35, y + 25);
+      XDrawLine(dpy, power_button_window, power_button_gc,
+                x + 35, y + 25, x + 28, y + 25);
+    } else {
+      XDrawArc(dpy, power_button_window, power_button_gc, x + 19, y + 18,
+               17, 17, 130 * 64, 280 * 64);
+      XDrawLine(dpy, power_button_window, power_button_gc,
+                x + 28, y + 14, x + 28, y + 25);
+    }
+    XDrawString(dpy, power_button_window, power_button_gc, x + 51, y + 33,
+                label, (int)strlen(label));
+  }
+}
+
+static Window PowerButtonInit(Display *dpy, Window background, int w, int h) {
+  power_button_window = XCreateSimpleWindow(
+      dpy, background, 0, 0, 2 * power_button_width + 12, power_button_height,
+      0, 0, BlackPixel(dpy, DefaultScreen(dpy)));
+  XStoreName(dpy, power_button_window, "xsecurelock-power-button");
+  XSelectInput(dpy, power_button_window, ExposureMask);
+  power_button_gc = XCreateGC(dpy, power_button_window, 0, NULL);
+  power_button_foreground = PowerButtonColor(dpy, "#f1f4f8");
+  power_button_border = PowerButtonColor(dpy, "#8299ad");
+  power_button_background = PowerButtonColor(dpy, "#202a34");
+  power_button_font = XLoadQueryFont(dpy, "9x15bold");
+  if (!power_button_font) power_button_font = XLoadQueryFont(dpy, "fixed");
+  if (power_button_font)
+    XSetFont(dpy, power_button_gc, power_button_font->fid);
+  PowerButtonPlace(dpy, w, h);
+  XMapWindow(dpy, power_button_window);
+  return power_button_window;
+}
+
+static void PowerButtonRequest(Display *dpy, int action) {
+  if (action < 0 || action >= POWER_ACTION_COUNT || power_pending_action >= 0)
+    return;
+  const char *verb = action == POWER_REBOOT ? "reboot" : "poweroff";
+  if (GetIntSetting("XSECURELOCK_POWER_TEST", 0)) {
+    Log("POWER_BUTTON_TEST: normal %s requested; no action executed", verb);
+    return;
+  }
+  pid_t pid = ForkWithoutSigHandlers();
+  if (pid == 0) {
+    /* The power child must not retain X11 or authentication pipe FDs. */
+    closefrom(3);
+    execl("/usr/bin/systemctl", "systemctl", "--no-ask-password",
+          "--check-inhibitors=yes", verb, (char *)NULL);
+    _exit(127);
+  }
+  power_button_pid = pid > 0 ? pid : 0;
+  power_pending_action = pid > 0 ? action : -1;
+  power_button_status[action] = pid > 0 ? 1 : 2;
+  PowerButtonDraw(dpy);
+}
+
+static void PowerButtonPoll(Display *dpy, Window auth) {
+  /* Stay above the saver and below authentication, never covering the prompt. */
+  XWindowChanges position = {.sibling = auth, .stack_mode = Below};
+  XConfigureWindow(dpy, power_button_window, CWSibling | CWStackMode, &position);
+  if (power_button_pid > 0) {
+    int status = 0;
+    const pid_t result = waitpid(power_button_pid, &status, WNOHANG);
+    if (result == power_button_pid || (result < 0 && errno == ECHILD)) {
+      power_button_pid = 0;
+      if (result < 0 || !WIFEXITED(status) || WEXITSTATUS(status) != 0) {
+        power_button_status[power_pending_action] = 2;
+        power_pending_action = -1;
+        Log("Power action was refused or failed; keeping the screen locked");
+        PowerButtonDraw(dpy);
+      }
+    }
+  }
+}
+
+static int PowerButtonAt(int x, int y) {
+  for (int action = 0; action < POWER_ACTION_COUNT; ++action) {
+    const int left = power_button_x + power_local_x[action];
+    const int top = power_button_y + power_local_y[action];
+    if (x >= left && y >= top && x < left + (int)power_button_width &&
+        y < top + (int)power_button_height) return action;
+  }
+  return -1;
+}
+
+static int PowerButtonEvent(Display *dpy, const XEvent *event, int auth_visible) {
+  if (event->type == Expose && event->xexpose.window == power_button_window) {
+    PowerButtonDraw(dpy);
+    return 1;
+  }
+  if (event->xany.send_event) return 0;
+  if (event->type == ButtonPress && event->xbutton.button == Button1) {
+    power_button_pressed = auth_visible ?
+        PowerButtonAt(event->xbutton.x_root, event->xbutton.y_root) : -1;
+    return power_button_pressed >= 0;
+  }
+  if (event->type == ButtonRelease && event->xbutton.button == Button1) {
+    const int pressed = power_button_pressed;
+    power_button_pressed = -1;
+    if (pressed >= 0 && auth_visible &&
+        PowerButtonAt(event->xbutton.x_root, event->xbutton.y_root) == pressed)
+      PowerButtonRequest(dpy, pressed);
+    return pressed >= 0;
+  }
+  return 0;
+}
