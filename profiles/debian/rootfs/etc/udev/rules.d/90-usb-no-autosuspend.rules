# User preference: keep USB devices and hubs awake, on AC and battery.
# TLP's USB_AUTOSUSPEND=0 stops TLP from managing devices; this also overrides
# autosuspend already enabled by a kernel driver and covers newly attached USB.
ACTION=="add|bind|change", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", TEST=="power/control", ATTR{power/control}="on"
ACTION=="add|bind|change", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", TEST=="power/autosuspend_delay_ms", ATTR{power/autosuspend_delay_ms}="-1"
